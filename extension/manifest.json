{
  "manifest_version": 3,
  "name": "TapGerman Dual Subtitles",
  "short_name": "TapGerman",
  "version": "0.4.0",
  "description": "Learn languages on Prime Video with dual subtitles, click-to-define vocabulary, and Anki export.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.primevideo.com/*",
    "https://*.pv-cdn.net/*",
    "https://kaikki.org/*",
    "https://api.mymemory.translated.net/*",
    "https://libretranslate.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TapGerman",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.ca/gp/video/*",
        "https://*.amazon.fr/gp/video/*",
        "https://*.amazon.it/gp/video/*",
        "https://*.amazon.es/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.com.au/gp/video/*",
        "https://*.amazon.in/gp/video/*",
        "https://*.amazon.com.br/gp/video/*",
        "https://*.amazon.com.mx/gp/video/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.ca/gp/video/*",
        "https://*.amazon.fr/gp/video/*",
        "https://*.amazon.it/gp/video/*",
        "https://*.amazon.es/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.com.au/gp/video/*",
        "https://*.amazon.in/gp/video/*",
        "https://*.amazon.com.br/gp/video/*",
        "https://*.amazon.com.mx/gp/video/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
