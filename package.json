{
  "name": "tapgerman",
  "version": "0.4.0",
  "description": "Chromium extension for Prime Video dual subtitles, structured word lookup, and Anki.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Md Mobashir Rahman",
  "homepage": "https://github.com/mobashirrahman/tapgerman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mobashirrahman/tapgerman.git"
  },
  "bugs": {
    "url": "https://github.com/mobashirrahman/tapgerman/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-extension.js",
    "icons": "node scripts/generate-icons.js",
    "icons:check": "node scripts/generate-icons.js --check",
    "package": "node scripts/package-extension.js",
    "verify": "npm run check && npm run icons:check && npm test"
  }
}
